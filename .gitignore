# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# storage (uploads, generated files, database)
# storage/demo-assets/ is intentionally NOT ignored — it holds canonical
# 3D demo assets that ship with the repo (Phase 6, T-094). Git's negation
# rules can't re-include children of an ignored directory, so we list
# subdirectories explicitly instead of ignoring `storage/` wholesale.
storage/cache/
storage/jobs/
storage/uploads/
storage/*.db
storage/*.db-shm
storage/*.db-wal
*.db

# claude code (per-user settings)
.claude/settings.local.json
.claude/worktrees/
